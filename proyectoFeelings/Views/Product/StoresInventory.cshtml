
@model List<proyectoFeelings.ViewModels.ProductViewModel>

<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />

<style>
    .products-card {
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.08);
    }

    .products-header {
        background: #0d6efd;
        color: white;
        padding: 16px 20px;
    }

    .products-header h3 {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 600;
    }

    .products-body {
        padding: 20px;
    }

    #productsTable {
        width: 100% !important;
        border-collapse: collapse !important;
    }

    #productsTable thead th {
        background: #e9ecef;
        color: #212529;
        font-weight: 600;
        white-space: nowrap;
        border: 1px solid #dee2e6 !important;
        padding: 12px 10px;
    }

    #productsTable tbody td {
        border: 1px solid #dee2e6 !important;
        padding: 10px;
        vertical-align: middle;
    }

    #productsTable tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    #productsTable tbody tr:hover {
        background-color: #e7f1ff;
    }

    .product-status {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .product-active {
        background: #d1e7dd;
        color: #0f5132;
    }

    .product-inactive {
        background: #f8d7da;
        color: #842029;
    }

    .product-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: none;
        border-radius: 5px;
        padding: 7px 10px;
        font-size: 0.85rem;
        text-decoration: none;
        white-space: nowrap;
    }

    .product-move {
        background: #ffc107;
        color: #212529;
    }

    .product-move:hover {
        background: #e0a800;
        color: #212529;
    }

    .product-edit {
        background: #0d6efd;
        color: white;
        min-width: 36px;
        min-height: 32px;
    }

    .product-edit:hover {
        background: #0b5ed7;
        color: white;
    }

    .products-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .products-toolbar p {
        margin: 4px 0 0;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .dataTables_wrapper .dt-search input,
    .dataTables_wrapper .dt-length select {
        border: 1px solid #ced4da;
        border-radius: 5px;
        padding: 6px 9px;
    }

    .dataTables_wrapper .dt-search input {
        margin-left: 6px;
    }

    .alert {
        border-radius: 8px;
    }

    @@media (max-width: 768px) {
        .products-body {
            padding: 12px;
        }

        .products-header {
            padding: 14px;
        }
    }
</style>

<div class="container-fluid mt-4 mb-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="products-card">

        <div class="products-header">
            <h3>Administración de productos</h3>
        </div>

        <div class="products-body">

            <div class="products-toolbar">
                <div>
                    <strong>Listado de productos</strong>
                    <p>Consultá y administrá los productos registrados.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle"
                       id="productsTable">

                    <thead>
                        <tr>
                            <th>Tienda</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th>Categoría</th>
                            <th>Cantidad</th>
                            <th>Precio</th>
                            <th>Proveedor</th>
                            <th>Estado</th>

                            @if (User.IsInRole("User"))
                            {
                                <th></th>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <th></th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>@product.StoreName</td>
                                <td>@product.Code</td>
                                <td>@product.Description</td>
                                <td>@product.Category</td>
                                <td>@product.Quantity</td>
                                <td>@product.Price</td>
                                <td>@product.Provider</td>

                                <td>
                                    @if (product.Status)
                                    {
                                        <span class="product-status product-active">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="product-status product-inactive">
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                @if (User.IsInRole("User"))
                                {
                                    <td>
                                        <a asp-controller="Product"
                                           asp-action="MoveProduct"
                                           asp-route-ProductID="@product.ProductID"
                                           asp-route-StoreID="@product.StoreID"
                                           class="product-action product-move">
                                            Trasladar producto
                                        </a>
                                    </td>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                                           <a asp-controller="Product"
                       asp-action="EditProduct"
                       asp-route-productId="@product.ProductID"
                       asp-route-storeId="@product.StoreID"
                       class="product-action"
                       style="background-color: #ffc107; color: #212529;"
                       title="Editar">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             width="16"
                             height="16"
                             fill="currentColor"
                             viewBox="0 0 16 16">
                            <path d="M12.854.146a.5.5 0 0 0-.707 0L11.5.793l3.707 3.707.647-.647a.5.5 0 0 0 0-.707zM10.793 1.5 1 11.293V15h3.707L14.5 5.207z" />
                        </svg>
                    </a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const hasUserRole = @User.IsInRole("User").ToString().ToLower();
        const hasAdminRole = @User.IsInRole("Admin").ToString().ToLower();

        const actionColumns = [];

        // Las columnas de acciones dependen del rol.
        if (hasUserRole) {
            actionColumns.push(8);
        }

        if (hasAdminRole) {
            actionColumns.push(hasUserRole ? 9 : 8);
        }

        new DataTable('#productsTable', {
            pageLength: 10,

            lengthMenu: [5, 10, 25, 50, 100],

            order: [[1, 'asc']],

            searching: true,
            ordering: true,
            autoWidth: false,
            scrollX: true,

            language: {
                search: "Buscar:",
                searchPlaceholder: "Buscar productos...",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ productos",
                infoEmpty: "No hay registros",
                infoFiltered: "(filtrado de _MAX_ productos)",
                zeroRecords: "No se encontraron resultados",
                emptyTable: "No hay productos registrados",

                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },

            columnDefs: [
                {
                    orderable: false,
                    searchable: false,
                    targets: actionColumns
                }
            ]
        });

    });
</script>
