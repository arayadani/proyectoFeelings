@model proyectoFeelings.ViewModels.RecordViewModel

@{
    ViewData["Title"] = "Trasladar producto";
}

<h2>Trasladar producto</h2>

<form asp-action="MoveProduct" method="post">

    <input asp-for="ProductID" type="hidden" />
    <input asp-for="NewStoreID" type="hidden" />
    <input asp-for="CurrentStoreID" type="hidden" />
    <input asp-for="Code" type="hidden" />
    <input asp-for="Description" type="hidden" />



    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label>Tienda actual</label>
        <input class="form-control" readonly
               value="@(Model.CurrentStoreID)" />
    </div>
    <div class="mb-3">
        <label>Tienda destino</label>
        <input class="form-control" readonly
               value="@(Model.NewStoreID)" />
    </div>
    <div class="mb-3">
        <label>Codigo del producto</label>
        <input class="form-control" readonly
               value="@(Model.Code)" />

    </div>

    <div class="mb-3">
        <label>Descripcion del producto</label>
        <input class="form-control" readonly
               value="@(Model.Description)" />
    </div>

    <div class="mb-3">
        <label asp-for="Comment" class="form-label">Comentario</label>
        <input asp-for="Comment" class="form-control" />
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>
   
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label">Cantidad</label>
        <input asp-for="Quantity" type="number" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>

    
    

    <button type="submit" class="btn btn-primary">
        Confirmar
    </button>

    <a asp-action="StoresInventory" class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}