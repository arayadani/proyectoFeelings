
@model proyectoFeelings.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Ingresar producto";
}

<div class="container mt-3">
    <div class="card shadow-sm">
        <div class="card-header py-2">
            <h5 class="mb-0">Ingresar producto</h5>
        </div>

        <div class="card-body p-3">
            <form asp-action="CreateProduct" method="post">

                <input asp-for="StoreID" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger small mb-2"></div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="StoreName" class="form-label mb-1">
                            Nombre de la tienda
                        </label>
                        <input asp-for="StoreName"
                               class="form-control form-control-sm"
                               readonly />
                        <span asp-validation-for="StoreName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label mb-1">
                            Código del producto
                        </label>
                        <input asp-for="Code"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Code"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Description" class="form-label mb-1">
                            Descripción
                        </label>
                        <input asp-for="Description"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Price" class="form-label mb-1">
                            Precio
                        </label>
                        <input asp-for="Price"
                               type="number"
                               step="0.01"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Price"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Quantity" class="form-label mb-1">
                            Cantidad
                        </label>
                        <input asp-for="Quantity"
                               type="number"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Quantity"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Provider" class="form-label mb-1">
                            Proveedor
                        </label>
                        <select asp-for="Provider"
                                class="form-select form-select-sm">
                            <option value="">Seleccione proveedor</option>
                            <option value="Maryfer">Maryfer</option>
                            <option value="Cajas Fragil">Cajas Fragil</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Provider"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Category" class="form-label mb-1">
                            Categoría
                        </label>
                        <select asp-for="Category"
                                class="form-select form-select-sm">
                            <option value="">Seleccione categoría</option>
                            <option value="Peluche">Peluche</option>
                            <option value="Globos">Globos</option>
                            <option value="Cajas de madera">Cajas de madera</option>
                            <option value="Empaque">Empaque</option>
                            <option value="Cojin">Cojín</option>
                            <option value="Tarjetas">Tarjetas</option>
                            <option value="Graduacion">Graduación</option>
                            <option value="Amor">Amor</option>
                            <option value="Madre">Madre</option>
                            <option value="Papa">Papá</option>
                            <option value="Familia">Familia</option>
                            <option value="Otro">Otro</option>
                        </select>
                        <span asp-validation-for="Category"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="Status"
                                   class="form-check-input" />
                            <label asp-for="Status"
                                   class="form-check-label">
                                Activo
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-3" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm px-3">
                        Crear producto
                    </button>

                    <a asp-action="ProductList"
                       class="btn btn-secondary btn-sm px-3">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
