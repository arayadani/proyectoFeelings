
@model proyectoFeelings.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Rebajar Producto";
}

<div class="container mt-3">
    <div class="card shadow-sm">

        <div class="card-header py-2">
            <h5 class="mb-0">Rebaja de productos</h5>
        </div>

        <div class="card-body p-3">

            <form asp-action="ProductReduction" method="post">

                <input asp-for="ProductID" type="hidden" />
                <input asp-for="StoreID" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger small mb-2"></div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="Code" class="form-label mb-1">
                            Código
                        </label>
                        <input asp-for="Code"
                               class="form-control form-control-sm"
                               readonly  />
                        <span asp-validation-for="Code"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="Description" class="form-label mb-1">
                            Descripción
                        </label>
                        <input asp-for="Description"
                               class="form-control form-control-sm" readonly/>
                        <span asp-validation-for="Description"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Quantity" class="form-label mb-1">
                            Cantidad
                        </label>

                        @if (User.IsInRole("Admin"))
                        {
                            <input asp-for="Quantity"
                                   type="number"
                                   class="form-control form-control-sm"
                                   max="@Model.Quantity" />
                        }
                

                        <span asp-validation-for="Quantity"
                              class="text-danger small"></span>
                    </div>

                    
                    <div class="col-md-3">
                        <label asp-for="Reason" class="form-label mb-1">
                            Razón del rebajo
                        </label>
                        <select asp-for="Reason"
                                class="form-select form-select-sm">
                            <option value="Robo">Robo</option>
                            <option value="Perdida">Perdida</option>
                            <option value="Daño">Daño</option>
                            <option value="Error de inventario">Error de inventario</option>
                            <option value="Otro">Otro</option>


                           
                        </select>
                        <span asp-validation-for="Category"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="Comment" class="form-label mb-1">
                            Comentario (obligatorio)
                        </label>
                        <input asp-for="Comment"
                               class="form-control form-control-sm"
                               required />
                        <span asp-validation-for="Comment"
                              class="text-danger small"></span>
                    </div>

                    

                </div>

                <hr class="my-3" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary btn-sm px-3">
                        Guardar cambios
                    </button>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="GeneralReduction"
                           class="btn btn-secondary btn-sm px-3">
                            Cancelar
                        </a>
                    }

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
