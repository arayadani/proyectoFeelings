@model List<proyectoFeelings.ViewModels.RecordViewModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Tienda</th>
            <th>Codigo</th>
            <th>Descripcion</th>
            <th>Cantidad</th>
            <th>Proveedor</th>
        </tr>
    </thead>
    <tbody>

  @foreach (var record in Model)
        {
            <tr>
                <td>@(record.Type)</td>

                <td>
                    @(record.CurrentStoreID == 7 ? "Multicentro" :
                      record.CurrentStoreID == 8 ? "Terramall" :
                      record.CurrentStoreID == 9 ? "San Sebastian" :
                      "Unknown")
                </td>
                <td>@(record.Code)</td>
                <td>@(record.Description)</td>
                <td>@(record.Quantity)</td>
                <td>@(record.Provider)</td>
                @if (record.Type == 1)
                {
                    <td>
                        <a asp-controller="Product"
                           asp-action="MoveProduct"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-StoreID="@record.CurrentStoreID"
                           class="btn btn-success btn-sm">
                            Aprobar
                        </a>
                    </td>
                    <td>
                        <a asp-controller="Product"
                           asp-action="MoveProduct"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-StoreID="@record.CurrentStoreID"
                           class="btn btn-error btn-sm">
                            Declinar
                        </a>
                    </td>
                }
                @if (record.Type == 2)
                {
                    <td>
                        <a asp-controller="Product"
                           asp-action="MoveProduct"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-StoreID="@record.CurrentStoreID"
                           class="btn btn-success btn-sm">
                            Entendido
                        </a>
                    </td>
                    
                }
                )
               
            </tr>
        }
    </tbody>
</table>