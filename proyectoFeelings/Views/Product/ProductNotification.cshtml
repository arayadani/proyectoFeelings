@model List<proyectoFeelings.ViewModels.RecordViewModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Tienda actual</th>
            <th>Tienda destino</th>
            <th>Codigo</th>
            <th>Descripcion</th>
            <th>Cantidad</th>
            <th>Proveedor</th>
            <th>Precio</th>
            <th>Categoria</th>
            <th>Fecha de la notificacion</th>
            <th>Comentario</th>



        </tr>
    </thead>
    <tbody>

  @foreach (var record in Model)
        {
            <tr>
                <td>
                    @(record.Type == 1 ? "Traslado" :
                          record.Type == 2 ? "ROP" :
                          "Otro")
                </td>

                <td>
                    @(record.CurrentStoreName)
                </td>
                <td>
                    @(record.NewStoreName==null? "N/A":
                    record.NewStoreName)
                </td>
                <td>@(record.Code)</td>
                <td>@(record.Description)</td>
                <td>@(record.Quantity)</td>
                <td>@(record.Provider)</td>
                <td>@(record.Price)</td>
                <td>@(record.Category)</td>
                <td>@(record.DateTime.ToString("dd/MM/yyyy"))</td>
                <td>@(record.Comment)</td>


                @if (record.Type == 1)
                {
                    <td>
                        <a asp-controller="Product"
                           asp-action="ApproveMove"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-CurrentStoreID="@record.CurrentStoreID"
                           asp-route-NewStoreID="@record.NewStoreID"
                           asp-route-Quantity="@record.Quantity"
                           asp-route-Code="@record.Code"
                           asp-route-Description="@record.Description"
                           asp-route-Provider="@record.Provider"
                           asp-route-Price="@record.Price"
                           asp-route-Category="@record.Category"
                           class="btn btn-success btn-sm">
                            Aprobar
                        </a>
                    </td>
                    <td>
                        <a asp-controller="Product"
                           asp-action="RejectMove"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-StoreID="@record.CurrentStoreID"
                           asp-route-Type="@record.Type"
                           class="btn btn-danger btn-sm">
                            Declinar
                        </a>
                    </td>
                }
                @if (record.Type == 2)
                {
                    <td>
                        <a asp-controller="Product"
                           asp-action="AckNotification"
                           asp-route-ProductID="@record.ProductID"
                           asp-route-StoreID="@record.CurrentStoreID"
                           asp-route-Type="@record.Type"
                           class="btn btn-success btn-sm">
                            Entendido
                        </a>
                    </td>
                    
                }
                
               
            </tr>
        }
    </tbody>
</table>