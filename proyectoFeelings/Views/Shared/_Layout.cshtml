<!DOCTYPE html>
<html lang="en">
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<User> UserManager

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - proyectoFeelings</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/proyectoFeelings.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex">

        @await Html.PartialAsync("_Sidebar")

        <div id="content" class="flex-grow-1">

            <nav class="navbar bg-light border-bottom">

                <button id="menuBtn"
                        class="btn btn-primary">
                    ☰
                </button>

                <!--

                Aqui va cerrar sesion
                -->
                @{
                    var currentUser = await UserManager.GetUserAsync(User);
                    var currentStoreId = currentUser?.StoreID;
                    var currentStore = await UserManager.Users
                        .Where(u => u.StoreID == currentStoreId)
                        .Select(u => u.Store)
                        .FirstOrDefaultAsync();
                }

                @if (currentUser != null)
                {
                    <span>Hola @currentUser.FullName - @currentUser.Store.StoreName</span>
                }
                

            </nav>

            <div class="container mt-3">
                @RenderBody()
            </div>

        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.getElementById("menuBtn")
        .addEventListener("click", function () {

        document.getElementById("sidebar")
        .classList.toggle("sidebar-hidden");
        });
    </script>
</body>
</html>
