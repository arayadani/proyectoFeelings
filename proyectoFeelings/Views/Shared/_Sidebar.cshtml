@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> signInManager;



<div id="sidebar">

    <div class="sidebar-header">
        Tiendas Feelings
    </div>

    <ul class="sidebar-menu">
        @if (signInManager.IsSignedIn(User))
        {
        
            <li>
          <a asp-controller="Home" asp-action="Index">
                Inicio
            </a>
        </li>

        }
        
         @if (User.IsInRole("Admin"))
        {
            <li>
                <a asp-controller="Home" asp-action="Admin">
                    Administrador
                </a>
            </li>
          
            
                    <li>
                        <a asp-controller="Account" asp-action="CreateUser">
                            Crear usuario
                        </a>
                    </li>

             
               <li>     
                   <a asp-controller="Account" asp-action="UserList">
                Lista de usuarios
                </a>   
                
               </li>
            <li>
                <a asp-controller="Store" asp-action="CreateStore">
                    Crear tienda
                </a>
            </li>

            <li>
                <a asp-controller="Store" asp-action="StoreList">
                    Lista de tiendas
                </a>

            </li>

                <li>
                    <a asp-controller="Product" asp-action="ProductNotification">
                        Notificaciones
                    </a>
          
        </li>
        
     

        }

        @if (User.IsInRole("Admin") || User.IsInRole("User"))
        {
            <li>
                <a asp-controller="Home" asp-action="User">
                    Colaborador
                </a>
            </li>
        
        }
        @if (User.IsInRole("User"))
        {
            <li>
                <a asp-controller="Product" asp-action="CreateProduct">
                    Ingresar producto
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="ProductList">
                    Lista de productos
                </a>
            </li>

            <li>
                <a asp-controller="Product" asp-action="StoresInventory">
                    Inventario general
                </a>
            </li>
        }
        @if (signInManager.IsSignedIn(User))
        {

            <li class="logout-item">
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-light p-0 text-decoration-none">
                        Cerrar sesión
                    </button>
                </form>
            </li>
        }
    </ul>

</div>