@using Microsoft.AspNetCore.Identity;
@inject SignInManager<User> signInManager;



<div id="sidebar">

    <div class="sidebar-header">
        Tienda Feelings
    </div>

    <ul class="sidebar-menu">
        @if (signInManager.IsSignedIn(User))
        {
        
            <li>
          <a asp-controller="Home" asp-action="Index">
                Inicio
            </a>
        </li>

        }
        
         @if (User.IsInRole("Admin"))
        {
            <li>
                <a asp-controller="Home" asp-action="Admin">
                    Administrador
                </a>
            </li>
            <li>
            <ul>
                <li>
                    <a asp-controller="Account" asp-action="CreateUser">
                        Crear usuario
                    </a>
                </li>
                    <li>
                        <a asp-controller="Account" asp-action="UserList">
                            Ver lista de usuarios
                        </a>
                    </li>
                   

            </ul>
                <li>
                    <a asp-controller="Product" asp-action="ProductNotification">
                        Notificaciones
                    </a>
                </li>
        </li>
        
     

        }

        @if (User.IsInRole("Admin") || User.IsInRole("User"))
        {
            <li>
                <a asp-controller="Home" asp-action="User">
                    Colaborador
                </a>
            </li>
        
        }
        @if (User.IsInRole("User"))
        {
            <li>
                <a asp-controller="Product" asp-action="CreateProduct">
                    Crear producto
                </a>
            </li>
            <li>
                <a asp-controller="Product" asp-action="ProductList">
                    Ver lista de productos
                </a>
            </li>

            <li>
                <a asp-controller="Product" asp-action="StoresInventory">
                    Inventario general
                </a>
            </li>
        }
        <div>
            <partial name="_LoginPartial" />
        </div>

    </ul>


</div>