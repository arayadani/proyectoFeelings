
@model proyectoFeelings.Models.Store

@{
    ViewData["Title"] = "Ingresar tienda";
}

<div class="container mt-3">
    <div class="card shadow-sm">

        <div class="card-header py-2">
            <h5 class="mb-0">Ingresar tienda</h5>
        </div>

        <div class="card-body p-3">

            <form asp-action="CreateStore" method="post">

                <div asp-validation-summary="All"
                     class="text-danger small mb-2"></div>

                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="StoreName"
                               class="form-label mb-1">
                            Nombre de la tienda
                        </label>
                        <input asp-for="StoreName"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="StoreName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Location"
                               class="form-label mb-1">
                            Ubicación
                        </label>
                        <input asp-for="Location"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Location"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhoneNumber"
                               class="form-label mb-1">
                            Número de teléfono
                        </label>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="Status"
                                   class="form-check-input" />
                            <label asp-for="Status"
                                   class="form-check-label">
                                Activo
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-3" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary btn-sm px-3">
                        Crear tienda
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary btn-sm px-3">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
