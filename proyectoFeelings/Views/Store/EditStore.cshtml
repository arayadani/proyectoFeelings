
@model proyectoFeelings.Models.Store

@{
    ViewData["Title"] = "Editar tienda";
}

<div class="container mt-4 mb-4">
    <div class="card shadow-sm mx-auto" style="max-width: 650px;">

        <div class="card-header bg-primary text-white py-2">
            <h5 class="mb-0">Editar tienda</h5>
        </div>

        <div class="card-body p-3">

            <form asp-action="EditStore" method="post">

                <input asp-for="StoreID" type="hidden" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="StoreName" class="form-label small mb-1">
                            Nombre de la tienda
                        </label>
                        <input asp-for="StoreName" class="form-control form-control-sm" />
                        <span asp-validation-for="StoreName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Location" class="form-label small mb-1">
                            Ubicación
                        </label>
                        <input asp-for="Location" class="form-control form-control-sm" />
                        <span asp-validation-for="Location" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small mb-1">
                            Número de teléfono
                        </label>
                        <input asp-for="PhoneNumber" class="form-control form-control-sm" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-check mt-3">
                            <input asp-for="Status" class="form-check-input" />
                            <label asp-for="Status" class="form-check-label small">
                                Activo
                            </label>
                        </div>
                    </div>

                </div>

                <hr class="my-3" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="StoreList" class="btn btn-secondary btn-sm">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary btn-sm">
                        Guardar cambios
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
