
@model List<proyectoFeelings.Models.Store>

@{
    ViewData["Title"] = "Administración de tiendas";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />

<style>
    .stores-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

    .stores-header {
        background: #0d6efd;
        color: white;
        padding: 14px 18px;
    }

    .stores-header h5 {
        margin: 0;
        font-weight: 600;
    }

    #storesTable {
        width: 100% !important;
        border-collapse: collapse !important;
        margin: 0 !important;
    }

    #storesTable thead th {
        background-color: #e9ecef;
        color: #212529;
        font-weight: 600;
        font-size: 13px;
        white-space: nowrap;
        border: 1px solid #ced4da !important;
        padding: 12px 10px;
    }

    #storesTable tbody td {
        border: 1px solid #dee2e6 !important;
        padding: 10px;
        vertical-align: middle;
        font-size: 13px;
    }

    #storesTable tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    #storesTable tbody tr:hover {
        background-color: #eaf2f8;
    }

    .store-badge {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-active {
        background: #d1e7dd;
        color: #0f5132;
    }

    .badge-inactive {
        background: #f8d7da;
        color: #842029;
    }

    .stores-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .store-edit-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        width: 32px;
        height: 30px;
        padding: 4px;
    }

    .store-edit-btn svg {
        width: 15px;
        height: 15px;
    }

    .dataTables_wrapper {
        padding: 12px;
    }

    .dt-search input,
    .dt-length select {
        border: 1px solid #ced4da !important;
        border-radius: 5px !important;
        padding: 5px 8px !important;
    }
</style>

<div class="container-fluid mt-3 mb-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="stores-card">

        <div class="stores-header d-flex justify-content-between align-items-center">
            <h5>
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     fill="currentColor"
                     viewBox="0 0 16 16"
                     style="margin-right: 7px; vertical-align: -3px;">
                    <path d="M8.5 2.687c.654-.689 1.782-.886 2.608-.396 1.29.764 1.29 2.654 0 3.418-.826.49-1.954.293-2.608-.396-.654.689-1.782.886-2.608.396-1.29-.764-1.29-2.654 0-3.418.826-.49 1.954-.293 2.608.396ZM1 7.5A1.5 1.5 0 0 1 2.5 6h11A1.5 1.5 0 0 1 15 7.5v6a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 13.5zM2.5 7a.5.5 0 0 0-.5.5v6a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-6a.5.5 0 0 0-.5-.5z"/>
                </svg>
                Administración de tiendas
            </h5>

            <span class="badge bg-light text-primary">
                Total: @Model.Count
            </span>
        </div>

        <div class="stores-table-wrapper">

            <table class="table table-bordered table-hover align-middle"
                   id="storesTable">

                <thead>
                    <tr>
                        <th>Tienda</th>
                        <th>Ubicación</th>
                        <th>Número de teléfono</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var store in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @store.StoreName
                            </td>

                            <td>@store.Location</td>

                            <td>@store.PhoneNumber</td>

                            <td>
                                @if (store.Status)
                                {
                                    <span class="store-badge badge-active">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="store-badge badge-inactive">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td>
                                <a asp-controller="Store"
                                   asp-action="EditStore"
                                   asp-route-storeId="@store.StoreID"
                                   class="btn btn-warning btn-sm store-edit-btn"
                                   title="Editar tienda"
                                   aria-label="Editar tienda">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         fill="currentColor"
                                         viewBox="0 0 16 16">
                                        <path d="M12.854.146a.5.5 0 0 0-.707 0L11.5.793l3.707 3.707.647-.647a.5.5 0 0 0 0-.707zM10.793 1.5 1 11.293V15h3.707L14.5 5.207z"/>
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        new DataTable('#storesTable', {
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50, 100],
            order: [[0, 'asc']],
            autoWidth: false,
            scrollX: true,

            language: {
                search: "Buscar:",
                searchPlaceholder: "Nombre, ubicación...",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ tiendas",
                infoEmpty: "No hay tiendas registradas",
                infoFiltered: "(filtrado de _MAX_ tiendas)",
                zeroRecords: "No se encontraron resultados",
                emptyTable: "No hay tiendas para mostrar",

                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },

            columnDefs: [
                {
                    orderable: false,
                    searchable: false,
                    targets: 4
                }
            ]
        });

    });
</script>
