<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <title>Facturación</title>
</head>

<body>

    <div class="container">

        <h1>Facturación</h1>

        <!-- Datos del producto -->
        <div class="form-grid">

            <div class="form-group">

                <label>Producto</label>
                <input
                    type="text"
                    id="productInput"
                    list="productList"
                    autocomplete="off"
                    placeholder="Buscar código..."
                >
            </div>
            <datalist id="productList">
            </datalist> 

            <div class="form-group">
                <label for="producto">Descripción</label>
                <input type="text" id="producto" name="producto" disabled > 
            </div>

            <div class="form-group">
                <label for="cantidad">Cantidad</label>
                <input type="number" id="cantidad" name="cantidad" min="1">
            </div>

            <div class="form-group">
                <label for="precio">Precio</label>
                <input type="text" id="precio" name="precio" disabled>
            </div>

        </div>

        <!-- Información de factura -->
        <div class="form-grid">

            <div class="form-group">
                <label for="fecha">Fecha</label>
                <input type="date" id="fecha" name="fecha" disabled >
            </div>

            <div class="form-group">
                <label for="metodoPago">Método de Pago</label>
                <select id="metodoPago" name="metodoPago">
                    <option value="efectivo">Efectivo</option>
                    <option value="tarjeta">Tarjeta</option>
                    <option value="sinpe">Sinpe movil</option>
                    <option value="otro">Otro</option>

                </select>
            </div>



        </div>

        <!-- Botón ingresar -->
        <div class="button-container">
            <button type="button" class="btn-ingresar" onclick="agregarProducto()">
                INGRESAR
            </button>
        </div>

        <!-- Detalle de factura -->
        <h2>Detalle de factura</h2>

        <table id="tablaProductos">

            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                    <th>Subtotal</th>
                    <th>Eliminar</th>

                </tr>
            </thead>

            <tbody>
                <!-- Los productos aparecerán aquí -->
            </tbody>

        </table>

        <!-- Totales -->
        <div class="totales">

            <table>

                <tr>
                    <td><strong>Total</strong></td>
                    <td id="subtotal">₡0.00</td>
                </tr>


            </table>

        </div>

        <!-- Facturar -->
        <div class="facturar-container">

            <button type="button"
                    class="btn-facturar"
                    onclick="facturar()">
                Generar e imprimir factura
            </button>

        </div>

    </div>


    <script>

            const fechaInput = document.getElementById("fecha");

            const hoy = new Date();

            const year = hoy.getFullYear();
            const month = String(hoy.getMonth() + 1).padStart(2, "0");
            const day = String(hoy.getDate()).padStart(2, "0");

            fechaInput.value = `${year}-${month}-${day}`;

            let productos = [];

            // ==========================
            // BUSCAR PRODUCTOS
            // ==========================

            const input = document.getElementById("productInput");
            const list = document.getElementById("productList");
            const productoInput = document.getElementById("producto");
            const precioInput = document.getElementById("precio");
            const metodoPagoInput = document.getElementById("metodoPago");


            input.addEventListener("input", function () {

                const term = this.value;

                if (term.length < 1) {
                    list.innerHTML = "";
                    return;
                }

                fetch(`/Billing/SearchValues?term=${encodeURIComponent(term)}`)
                    .then(response => response.json())
                    .then(data => {

                        list.innerHTML = "";

                        data.forEach(item => {

                            const option = document.createElement("option");

                            option.value = item.code;

                            list.appendChild(option);
                        });
                         // Modify productoInput
                           productoInput.value = data[0].description;
                           // Modify precioInput
                            precioInput.value = data[0].price;
                    });
            });



        
            // ==========================
            // AGREGAR PRODUCTO
            // ==========================

            function agregarProducto() {

                const codigo = document.getElementById("productInput").value;

                const producto = productoInput.value;
                const metodoPago = metodoPagoInput.value;

                const cantidad = parseInt(
                    document.getElementById("cantidad").value
                );

                const precio = parseFloat(
                    precioInput.value
                );


                if (!codigo || !producto || !cantidad || !precio || !metodoPago) {

                    alert("Complete los datos del producto.");

                    return;
                }


                const subtotal = cantidad * precio;


                productos.push({

                    codigo: codigo,

                    producto: producto,

                    cantidad: cantidad,

                    precio: precio,

                    subtotal: subtotal

                });


                actualizarTabla();

                calcularTotales();


                // Limpiar campos

                input.value = "";

                productoInput.value = "";

                document.getElementById("cantidad").value = "";

                precioInput.value = "";

                list.innerHTML = "";

            }
        

            // ==========================
            // ACTUALIZAR TABLA
            // ==========================

            function actualizarTabla() {

                const tbody = document.querySelector(
                    "#tablaProductos tbody"
                );

                tbody.innerHTML = "";


                productos.forEach(function (producto) {

                    const fila = document.createElement("tr");


                    fila.innerHTML = `

                        <td>${producto.codigo}</td>

                        <td>${producto.producto}</td>

                        <td>${producto.cantidad}</td>

                        <td>₡${producto.precio.toFixed(2)}</td>

                        <td>₡${producto.subtotal.toFixed(2)}</td>

                           <td>
                            <button type="button"
                                    class="btn-eliminar"
                                    onclick="eliminarProducto(this)"
                                    title="Eliminar producto">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </td>

                    `;


                    tbody.appendChild(fila);

                });

            }


            // ==========================
            // CALCULAR TOTALES
            // ==========================

            function calcularTotales() {

                let subtotal = 0;


                productos.forEach(function (producto) {

                    subtotal += producto.subtotal;

                });


                document.getElementById("subtotal").innerText =
                    "₡" + subtotal.toFixed(2);

            }

            //ELIMINAR PRODUCTO
                function eliminarProducto(boton) {
                const fila = boton.closest("tr");
                const codigo = fila.cells[0].textContent.trim();

                // Eliminar del array
                const index = productos.findIndex(
                    p => String(p.codigo) === codigo
                );

                if (index !== -1) {
                    productos.splice(index, 1);
                }

                // Eliminar de la tabla
                fila.remove();

                // Recalcular el total
                calcularTotales();
            }

            // ==========================
            // FACTURAR
            // ==========================

                function facturar() {

                if (productos.length === 0) {
                    alert("No hay productos en la factura.");
                    return;
                }

                             // Open the window directly from the button click
            const ventana = window.open("", "_blank");

            if (!ventana) {
                alert("Permita las ventanas emergentes para poder generar la factura.");
            }

            // Format currency
            const formatoMoneda = valor =>
                Number(valor).toLocaleString("es-CR", {
                    style: "currency",
                    currency: "CRC",
                    minimumFractionDigits: 2
                });

            // Prevent product descriptions from inserting HTML
            const escaparHTML = valor =>
                String(valor ?? "").replace(/[&<>"']/g, caracter => ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[caracter]);

            const fecha = new Date().toLocaleString("es-CR");
            const numeroFactura = Date.now().toString();

            // Calculate the total from the product list
            const total2 = productos.reduce(
                (suma, p) => suma + Number(p.subtotal || 0),
                0
            );

            // Generate the product rows
            const filas = productos.map(p => `
                <tr>
                    <td>${escaparHTML(p.codigo)}</td>
                    <td>${escaparHTML(p.producto)}</td>
                    <td class="numero">${Number(p.cantidad)}</td>
                    <td class="numero">${formatoMoneda(p.precio)}</td>
                    <td class="numero">${formatoMoneda(p.subtotal)}</td>
                </tr>
            `).join("");

            const facturaHTML = `
                <!DOCTYPE html>
                <html lang="es">
                <head>
                    <meta charset="UTF-8">
                    <meta name="viewport" content="width=device-width, initial-scale=1.0">
                    <title>Factura ${numeroFactura}</title>

                    <style>
                        body {
                            font-family: Arial, sans-serif;
                            color: #222;
                            margin: 35px;
                            font-size: 13px;
                        }

                        .encabezado {
                            display: flex;
                            justify-content: space-between;
                            align-items: flex-start;
                            border-bottom: 2px solid #333;
                            padding-bottom: 15px;
                            margin-bottom: 20px;
                        }

                        h1 {
                            margin: 0 0 8px;
                            font-size: 26px;
                        }

                        .datos {
                            text-align: right;
                            line-height: 1.8;
                        }

                        table {
                            width: 100%;
                            border-collapse: collapse;
                            margin-top: 20px;
                        }

                        th, td {
                            border: 1px solid #ccc;
                            padding: 10px 8px;
                            text-align: left;
                        }

                        th {
                            background: #f0f0f0;
                        }

                        .numero {
                            text-align: right;
                            white-space: nowrap;
                        }

                        .total {
                            margin-top: 20px;
                            text-align: right;
                            font-size: 20px;
                            font-weight: bold;
                        }

                        .acciones {
                            margin-top: 30px;
                            text-align: center;
                        }

                        button {
                            padding: 10px 20px;
                            margin: 5px;
                            border: none;
                            border-radius: 4px;
                            cursor: pointer;
                            background: #198754;
                            color: white;
                            font-size: 14px;
                        }

                        .cerrar {
                            background: #6c757d;
                        }

                        
                    </style>
                </head>

                <body>
                    <div class="encabezado">
                        <div>
                            <h1>FACTURA</h1>
                            <p>Gracias por su compra.</p>
                        </div>

                        <div class="datos">
                            <strong>Número:</strong> ${numeroFactura}<br>
                            <strong>Fecha:</strong> ${escaparHTML(fecha)}
                        </div>
                    </div>

                    <h3>Detalle de productos</h3>

                    <table>
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Descripción</th>
                                <th class="numero">Cantidad</th>
                                <th class="numero">Precio unitario</th>
                                <th class="numero">Subtotal</th>
                            </tr>
                        </thead>

                        <tbody>
                            ${filas}
                        </tbody>
                    </table>

                    <div class="total">
                        Total: ${formatoMoneda(total2)}
                    </div>

                    <div class="acciones">
                        <button onclick="window.print()">Imprimir factura</button>
                        <button class="cerrar" onclick="window.close()">Cerrar</button>
                    </div>
                </body>
                </html>
            `;

            ventana.document.open();
            ventana.document.write(facturaHTML);
            ventana.document.close();

            // Open the print dialog after the invoice has loaded
            ventana.onload = function () {
                ventana.focus();
                ventana.print();
            };


            //esto manda el request al controller
                const token = document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

                const total = parseFloat(
                    document.getElementById("subtotal")
                        .textContent
                        .replace("₡", "")
                        .replace(/,/g, "")
                        .trim()
                );

                console.log("Total3:", total);
                
                fetch('/Billing/InvoiceCreation', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(
                        {
                            total: total,
                            metodoPago: metodoPagoInput.value,
                            productos: productos
                        }
                    )
                })
                .then(response => {

                    if (!response.ok) {
                        throw new Error("Error al generar la factura");
                    }

                    return response.json();
                })
                .then(data => {

                    console.log(data);

                    if (data.success) {
                        alert("Factura generada correctamente.");

                        input.value = "";

                        productoInput.value = "";

                        document.getElementById("cantidad").value = "";

                        precioInput.value = "";

                        list.innerHTML = "";

                        productos = [ ];
                        actualizarTabla();
                        calcularTotales();
                        return;

                    } else {
                        alert(data.message || "No se pudo generar la factura.");
                    }

                })
                .catch(error => {
                    console.error("Error:", error);
                    alert("Ocurrió un error al generar la factura.");
                });
            }
    </script>

</body>
<style>
