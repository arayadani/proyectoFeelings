
@model proyectoFeelings.ViewModels.UserViewModel

@{
    ViewData["Title"] = "Crear usuario";
}

<div class="container mt-3">
    <div class="card shadow-sm">

        <div class="card-header py-2">
            <h5 class="mb-0">Crear usuario</h5>
        </div>

        <div class="card-body p-3">

            <form asp-action="CreateUser" method="post">

                <div asp-validation-summary="All"
                     class="text-danger small mb-2"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="FullName"
                               class="form-label mb-1">
                            Nombre completo
                        </label>
                        <input asp-for="FullName"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="FullName"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email"
                               class="form-label mb-1">
                            Correo electrónico
                        </label>
                        <input asp-for="Email"
                               type="email"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhoneNumber"
                               class="form-label mb-1">
                            Número de teléfono
                        </label>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               class="form-control form-control-sm" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label for="password"
                               class="form-label mb-1">
                            Contraseña
                        </label>
                        <input id="password"
                               name="password"
                               type="password"
                               class="form-control form-control-sm"
                               required />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StoreId"
                               class="form-label mb-1">
                            Tienda
                        </label>
                        <select asp-for="StoreId"
                                asp-items="Model.Stores"
                                class="form-select form-select-sm">
                            <option value="">Seleccione la tienda</option>
                        </select>
                        <span asp-validation-for="StoreId"
                              class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-4">

                            <div class="form-check">
                                <input asp-for="AdminAccess"
                                       class="form-check-input" />
                                <label asp-for="AdminAccess"
                                       class="form-check-label">
                                    Acceso de administrador
                                </label>
                            </div>

                            <div class="form-check">
                                <input asp-for="Status"
                                       class="form-check-input" />
                                <label asp-for="Status"
                                       class="form-check-label">
                                    Usuario activo
                                </label>
                            </div>

                        </div>
                    </div>

                </div>

                <hr class="my-3" />

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary btn-sm px-3">
                        Crear usuario
                    </button>

                    <a asp-action="UserList"
                       class="btn btn-secondary btn-sm px-3">
                        Cancelar
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
