
@model List<proyectoFeelings.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css" />

<style>
    .users-card {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    }

   .users-header {
    background: #0d6efd;
    color: white;
    padding: 14px 18px;
}

    .users-header h5 {
        margin: 0;
        font-weight: 600;
    }

    #usersTable {
        width: 100% !important;
        border-collapse: collapse !important;
        margin: 0 !important;
    }

    #usersTable thead th {
        background-color: #e9ecef;
        color: #212529;
        font-weight: 600;
        font-size: 13px;
        white-space: nowrap;
        border: 1px solid #ced4da !important;
        padding: 12px 10px;
    }

    #usersTable tbody td {
        border: 1px solid #dee2e6 !important;
        padding: 10px;
        vertical-align: middle;
        font-size: 13px;
    }

    #usersTable tbody tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    #usersTable tbody tr:hover {
        background-color: #eaf2f8;
    }

    .user-badge {
        display: inline-block;
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-admin {
        background: #e2d9f3;
        color: #59359a;
    }

    .badge-collaborator {
        background: #cff4fc;
        color: #055160;
    }

    .badge-active {
        background: #d1e7dd;
        color: #0f5132;
    }

    .badge-inactive {
        background: #f8d7da;
        color: #842029;
    }

    .user-actions {
        display: flex;
        gap: 6px;
        align-items: center;
        white-space: nowrap;
    }

    .btn-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 30px;
        padding: 4px;
    }

    .btn-icon svg {
        width: 15px;
        height: 15px;
    }

    .btn-password {
        font-size: 12px;
        white-space: nowrap;
    }

    .users-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .users-footer {
        padding: 12px 16px;
        border-top: 1px solid #dee2e6;
        background: #fff;
    }

    .dataTables_wrapper {
        padding: 12px;
    }

    .dt-search input,
    .dt-length select {
        border: 1px solid #ced4da !important;
        border-radius: 5px !important;
        padding: 5px 8px !important;
    }

    .alert {
        border-radius: 8px;
    }
</style>

<div class="container-fluid mt-3 mb-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="users-card">

        <div class="users-header d-flex justify-content-between align-items-center">
            <h5>
                <svg xmlns="http://www.w3.org/2000/svg"
                     width="20" height="20"
                     fill="currentColor"
                     viewBox="0 0 16 16"
                     style="margin-right: 7px; vertical-align: -3px;">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM12.735 14c.67 0 1.201-.695.845-1.262A5.99 5.99 0 0 0 8 10a5.99 5.99 0 0 0-5.58 2.738C2.064 13.305 2.595 14 3.265 14z"/>
                    <path d="M4.5 3a2.5 2.5 0 0 0-2.45 3.004A3.5 3.5 0 0 0 .5 8.75c0 .69.56 1.25 1.25 1.25h.63a6.98 6.98 0 0 1 1.17-1.13A3 3 0 0 1 4.5 3ZM11.5 3a2.5 2.5 0 0 1 2.45 3.004A3.5 3.5 0 0 1 15.5 8.75c0 .69-.56 1.25-1.25 1.25h-.63a6.98 6.98 0 0 0-1.17-1.13A3 3 0 0 0 11.5 3Z"/>
                </svg>
                Administración de usuarios
            </h5>

            <span class="badge bg-light text-dark">
                Total: @Model.Count
            </span>
        </div>

        <div class="users-table-wrapper">

            <table class="table table-bordered table-hover align-middle"
                   id="usersTable">

                <thead>
                    <tr>
                        <th>Nombre completo</th>
                        <th>Correo</th>
                        <th>Tipo de usuario</th>
                        <th>Estado</th>
                        <th>Tienda</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @user.FullName
                            </td>

                            <td>@user.Email</td>

                            <td>
                                @if (user.AdminAccess)
                                {
                                    <span class="user-badge badge-admin">
                                        Administrador
                                    </span>
                                }
                                else
                                {
                                    <span class="user-badge badge-collaborator">
                                        Colaborador
                                    </span>
                                }
                            </td>

                            <td>
                                @if (user.Status)
                                {
                                    <span class="user-badge badge-active">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="user-badge badge-inactive">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td>@user.StoreName</td>

                            <td>@user.PhoneNumber</td>

                            <td>
                                <div class="user-actions">

                                    <a asp-controller="Account"
                                       asp-action="EditUser"
                                       asp-route-id="@user.Id"
                                       class="btn btn-warning btn-sm btn-icon"
                                       title="Editar usuario"
                                       aria-label="Editar usuario">

                                        <svg xmlns="http://www.w3.org/2000/svg"
                                             fill="currentColor"
                                             viewBox="0 0 16 16">
                                            <path d="M12.854.146a.5.5 0 0 0-.707 0L11.5.793l3.707 3.707.647-.647a.5.5 0 0 0 0-.707zM10.793 1.5 1 11.293V15h3.707L14.5 5.207z"/>
                                        </svg>
                                    </a>

                                    <a asp-controller="Account"
                                       asp-action="ChangePassword"
                                       asp-route-id="@user.Id"
                                       class="btn btn-outline-primary btn-sm btn-password">
                                        Cambiar contraseña
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    </div>
</div>

<script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        new DataTable('#usersTable', {
            pageLength: 10,
            lengthMenu: [5, 10, 25, 50, 100],
            order: [[0, 'asc']],
            autoWidth: false,
            scrollX: true,

            language: {
                search: "Buscar:",
                searchPlaceholder: "Nombre, correo, tienda...",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ usuarios",
                infoEmpty: "No hay usuarios registrados",
                infoFiltered: "(filtrado de _MAX_ usuarios)",
                zeroRecords: "No se encontraron resultados",
                emptyTable: "No hay usuarios para mostrar",

                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },

            columnDefs: [
                {
                    orderable: false,
                    searchable: false,
                    targets: 6
                }
            ]
        });

    });
</script>
