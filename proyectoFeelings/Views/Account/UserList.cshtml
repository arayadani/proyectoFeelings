@model List<proyectoFeelings.ViewModels.UserViewModel>
<link rel="stylesheet"
      href="https://cdn.datatables.net/3.0.2/css/dataTables.dataTables.css" />

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<table class="table" id="usersTable">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Correo</th>
            <th>Tipo de usuario</th>
            <th>Estado</th>
            <th>Tienda</th>
            <th>Numero de telefono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@(user.AdminAccess ? "Administrador" : "Colaborador")</td>
                <td>@(user.Status ? "Activo" : "Inactivo")</td>
                <td>@user.StoreName</td>

                <td>@user.PhoneNumber</td>
                <td>
                    <a asp-controller="Account"
                       asp-action="EditUser"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                </td>
                <td>
                    <a asp-controller="Account"
                       asp-action="ChangePassword"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Cambiar contraseña
                    </a>

                </td>


            </tr>
        }
    </tbody>
</table>
    <script src="https://cdn.datatables.net/3.0.2/js/dataTables.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            new DataTable('#usersTable', {

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50, 100],

                order: [[0, 'asc']],

                language: {
                    search: "Buscar:",
                    lengthMenu: "",
                    info: "",
                    infoEmpty: "No hay registros",
                    zeroRecords: "No se encontraron resultados",

                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },

                columnDefs: [
                    {
                        orderable: false,
                        targets: [6, 7]
                    }
                ]

            });

        });
    </script>