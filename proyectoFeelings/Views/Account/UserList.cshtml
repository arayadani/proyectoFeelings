@model List<proyectoFeelings.ViewModels.UserViewModel>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Correo</th>
            <th>Tipo de usuario</th>
            <th>Estado</th>
            <th>Tienda</th>
            <th>Numero de telefono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@(user.AdminAccess ? "Administrador" : "Colaborador")</td>
                <td>@(user.Status ? "Activo" : "Inactivo")</td>
                <td>
                    @(user.StoreId == 11 ? "Multicentro" :
                      user.StoreId == 2025 ? "Terramall" :
                      user.StoreId == 2026 ? "San Sebastian" :
                      "Unknown")
                </td>
                <td>@user.PhoneNumber</td>
                <td>
                    <a asp-controller="Account"
                       asp-action="EditUser"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                </td>

                <td>
                    <a asp-controller="Account"
                       asp-action=""
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Borrar
                    </a>

                </td>

            </tr>
        }
    </tbody>
</table>