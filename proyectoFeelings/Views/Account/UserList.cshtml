@model List<proyectoFeelings.Models.User>

<table class="table">
    <thead>
        <tr>
            <th>Nombre completo</th>
            <th>Correo</th>
            <th>Tipo de usuario</th>
            <th>Estado</th>
            <th>Tienda</th>
            <th>Numero de telefono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>@(user.AdminAccess ? "Administrador" : "Colaborador")</td>
                <td>@(user.Status ? "Activo" : "Inactivo")</td>
                <td>@user.StoreID</td>
                <td>@user.PhoneNumber</td>
                <td>
                    <a asp-controller="Account"
                       asp-action="EditUser"
                       asp-route-id="@user.Id"
                       class="btn btn-warning btn-sm">
                        Editar
                    </a>

                </td>

            </tr>
        }
    </tbody>
</table>